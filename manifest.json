{
  "manifest_version": 3,
  "name": "Zabansaz Apex",
  "version": "4.0.0",
  "description": "رمزنگاری سرتاسری AES-256 روی چت وب + دکمه رمزی موبایل + سایت‌های سفارشی",
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zabansaz Apex",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.rubika.ir/*",
        "https://web.telegram.org/*",
        "https://web.whatsapp.com/*",
        "https://discord.com/*"
      ],
      "js": [
        "cipher.js",
        "engine.js",
        "mobile.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
